+import { en } from "../../src/i18n/en";
+import { es } from "../../src/i18n/es";
+
+/**
+ * Flattens the generated translation dictionaries (nested objects of strings, some with
+ * `{{placeholder}}` interpolation) into a flat list of leaf strings.
+ */
+function leaves(obj: unknown, out: string[] = []): string[] {
+  if (typeof obj === "string") {
+    out.push(obj);
+  } else if (obj && typeof obj === "object") {
+    for (const v of Object.values(obj)) leaves(v, out);
+  }
+  return out;
+}
+
+/**
+ * English phrases that are actually translated (differ from their Spanish counterpart) and are
+ * long/distinctive enough that finding one verbatim on a Spanish-locale screen is real evidence
+ * of an English leak, not a coincidental shared acronym (SKU, PIN, QR) or brand name.
+ */
+export const TRANSLATED_ENGLISH_PHRASES: string[] = (() => {
+  const enLeaves = leaves(en);
+  const esLeaves = new Set(leaves(es));
+  const seen = new Set<string>();
+  const out: string[] = [];
+  for (const phrase of enLeaves) {
+    const clean = phrase.replace(/\{\{[^}]+\}\}/g, "").trim();
+    if (clean.length < 8) continue;
+    if (!/[a-zA-Z]/.test(clean)) continue;
+    if (esLeaves.has(phrase)) continue;
+    if (seen.has(clean)) continue;
+    seen.add(clean);
+    out.push(clean);
+  }
+  return out;
+})();
+
+/**
+ * Returns every translated English phrase found verbatim inside `text` (expected: none, on a
+ * Spanish-locale screen).
+ */
+export function englishLeaksIn(text: string): string[] {
+  return TRANSLATED_ENGLISH_PHRASES.filter((phrase) => text.includes(phrase));
+}
